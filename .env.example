# Backend
APP_NAME=DaoYou API
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api

# Database
DATABASE_URL=postgresql+psycopg://daoyou:daoyou@localhost:5432/daoyou

# Demo defaults
DEFAULT_USER_ID=1
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=10

# External APIs
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20

AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_SECONDS=10

VISION_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_TIMEOUT_SECONDS=30

OCR_PROVIDER=vivo
VIVO_APP_ID=
VIVO_APP_KEY=
VIVO_OCR_URI=/ocr/general_recognition
VIVO_OCR_TIMEOUT_SECONDS=20
